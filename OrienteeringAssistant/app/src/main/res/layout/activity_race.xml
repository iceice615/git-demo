<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/tvCompInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="赛事信息"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- 计时器：正计时 / 积分赛倒计时 -->
    <TextView
        android:id="@+id/tvTimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="00:00"
        android:textColor="@color/primary"
        android:textSize="54sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="打卡进度 0 / 0"
        android:textColor="@color/text_secondary"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tvHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text=""
        android:textColor="#98A2B3"
        android:textSize="12sp" />

    <ListView
        android:id="@+id/lvCheckpoints"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:divider="#EDF0F3"
        android:dividerHeight="1dp" />

    <!-- 扫码按钮：想扫的时候点，随时可以退出扫码界面，比赛不受影响 -->
    <Button
        android:id="@+id/btnScan"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="扫码打卡"
        android:textAllCaps="false"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- 滑动结束：必须按住圆钮滑到底才生效，防止误触 -->
    <com.example.orienteeringassistant.widget.SlideFinishView
        android:id="@+id/slideFinish"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="10dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="向左按住圆钮滑到最右端才会结束比赛"
        android:textColor="#98A2B3"
        android:textSize="11sp" />

</LinearLayout>
